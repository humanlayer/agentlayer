{
	"name": "@humanlayer/agentlayer-core",
	"module": "src/index.ts",
	"type": "module",
	"version": "0.0.0",
	"private": false,
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./prompts": {
				"types": "./dist/prompts/index.d.ts",
				"import": "./dist/prompts/index.js",
				"default": "./dist/prompts/index.js"
			},
			"./tools": {
				"types": "./dist/tools/index.d.ts",
				"import": "./dist/tools/index.js",
				"default": "./dist/tools/index.js"
			},
			"./hooks": {
				"types": "./dist/hooks/index.d.ts",
				"import": "./dist/hooks/index.js",
				"default": "./dist/hooks/index.js"
			},
			"./utils": {
				"types": "./dist/utils/index.d.ts",
				"import": "./dist/utils/index.js",
				"default": "./dist/utils/index.js"
			},
			"./interfaces": {
				"types": "./dist/interfaces/index.d.ts",
				"import": "./dist/interfaces/index.js",
				"default": "./dist/interfaces/index.js"
			}
		}
	},
	"files": [
		"src",
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"build": "bun run build:js && bunx tsc -p tsconfig.build.json",
		"build:js": "bun run build.ts",
		"build:types": "bunx tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "catalog:",
		"@ai-sdk/provider": "catalog:",
		"@types/bun": "latest",
		"@types/turndown": "5.0.6",
		"ai": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"exports": {
		".": "./src/index.ts",
		"./prompts": "./src/prompts/index.ts",
		"./tools": "./src/tools/index.ts",
		"./hooks": "./src/hooks/index.ts",
		"./utils": "./src/utils/index.ts",
		"./interfaces": "./src/interfaces/index.ts"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"dedent": "^1.7.2",
		"turndown": "7.2.4"
	}
}
