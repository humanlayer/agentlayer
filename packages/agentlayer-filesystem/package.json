{
	"name": "@humanlayer/agentlayer-filesystem",
	"module": "src/index.ts",
	"type": "module",
	"version": "0.0.0",
	"private": false,
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./utils": {
				"types": "./dist/utils/index.d.ts",
				"import": "./dist/utils/index.js",
				"default": "./dist/utils/index.js"
			},
			"./tools": {
				"types": "./dist/tools/index.d.ts",
				"import": "./dist/tools/index.js",
				"default": "./dist/tools/index.js"
			},
			"./hooks": {
				"types": "./dist/hooks/index.d.ts",
				"import": "./dist/hooks/index.js",
				"default": "./dist/hooks/index.js"
			},
			"./prompts": {
				"types": "./dist/prompts/index.d.ts",
				"import": "./dist/prompts/index.js",
				"default": "./dist/prompts/index.js"
			},
			"./coding-agent": {
				"types": "./dist/coding-agent.d.ts",
				"import": "./dist/coding-agent.js",
				"default": "./dist/coding-agent.js"
			}
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"build": "bun run build:js && bunx tsc -p tsconfig.build.json",
		"build:js": "bun run build.ts",
		"build:types": "bunx tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"ripgrep": "0.3.1"
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "catalog:",
		"@ai-sdk/provider": "catalog:",
		"@humanlayer/agentlayer-core": "workspace:*",
		"@types/bun": "latest",
		"ai": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"exports": {
		".": "./src/index.ts",
		"./utils": "./src/utils/index.ts",
		"./tools": "./src/tools/index.ts",
		"./hooks": "./src/hooks/index.ts",
		"./prompts": "./src/prompts/index.ts",
		"./coding-agent": "./src/coding-agent.ts"
	}
}
