{
	"name": "@humanlayer/yjs-fs",
	"source": "./src/index.ts",
	"type": "module",
	"version": "0.0.0",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"build": "bun run build:js && bunx tsc -p tsconfig.build.json",
		"build:js": "bun run build.ts",
		"build:types": "bunx tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "catalog:",
		"@ai-sdk/provider": "catalog:",
		"@humanlayer/agentlayer-core": "workspace:*",
		"@types/bun": "latest",
		"@types/turndown": "5.0.6",
		"ai": "catalog:",
		"fast-check": "^4.3.0",
		"lib0": "0.2.117",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"lib0": "^0.2.0",
		"typescript": "^5",
		"yjs": "13.6.30",
		"y-protocols": "1.0.7"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./presence": {
			"source": "./src/filesystem/presence.ts",
			"types": "./dist/filesystem/presence.d.ts",
			"import": "./dist/filesystem/presence.js",
			"default": "./dist/filesystem/presence.js"
		}
	},
	"dependencies": {},
	"author": {
		"name": "Kyle Mistele",
		"url": "https://x.com/0xblacklight"
	}
}
