{
	"name": "@humanlayer/yjs-fs",
	"module": "src/index.ts",
	"type": "module",
	"version": "0.0.0",
	"private": false,
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./presence": {
				"types": "./dist/filesystem/presence.d.ts",
				"import": "./dist/filesystem/presence.js",
				"default": "./dist/filesystem/presence.js"
			},
			"./durable-streams/shared": {
				"types": "./dist/durable-streams/shared/index.d.ts",
				"import": "./dist/durable-streams/shared/index.js",
				"default": "./dist/durable-streams/shared/index.js"
			},
			"./durable-streams/client": {
				"types": "./dist/durable-streams/client/index.d.ts",
				"import": "./dist/durable-streams/client/index.js",
				"default": "./dist/durable-streams/client/index.js"
			},
			"./durable-streams/server": {
				"types": "./dist/durable-streams/server/index.d.ts",
				"import": "./dist/durable-streams/server/index.js",
				"default": "./dist/durable-streams/server/index.js"
			},
			"./durable-streams/single-stream-client": {
				"types": "./dist/durable-streams/client/single-root-doc.d.ts",
				"import": "./dist/durable-streams/client/single-root-doc.js",
				"default": "./dist/durable-streams/client/single-root-doc.js"
			}
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"build": "bun run build:js && bunx tsc -p tsconfig.build.json",
		"build:js": "bun run build.ts",
		"build:types": "bunx tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "catalog:",
		"@ai-sdk/provider": "catalog:",
		"@durable-streams/client": "0.2.1",
		"@durable-streams/server": "0.1.7",
		"@durable-streams/y-durable-streams": "0.2.4",
		"@humanlayer/agentlayer-core": "workspace:*",
		"@types/bun": "latest",
		"@types/turndown": "5.0.6",
		"ai": "catalog:",
		"fast-check": "^4.3.0",
		"lib0": "0.2.117",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@durable-streams/client": "^0.2.1",
		"@durable-streams/server": "^0.1.7",
		"@durable-streams/y-durable-streams": "^0.1.4",
		"lib0": "^0.2.0",
		"typescript": "^5",
		"yjs": "13.6.30",
		"y-protocols": "1.0.7"
	},
	"peerDependenciesMeta": {
		"@durable-streams/client": {
			"optional": true
		},
		"@durable-streams/server": {
			"optional": true
		},
		"@durable-streams/y-durable-streams": {
			"optional": true
		}
	},
	"exports": {
		".": "./src/index.ts",
		"./presence": "./src/filesystem/presence.ts",
		"./durable-streams/shared": "./src/durable-streams/shared/index.ts",
		"./durable-streams/client": "./src/durable-streams/client/index.ts",
		"./durable-streams/server": "./src/durable-streams/server/index.ts",
		"./durable-streams/single-stream-client": "./src/durable-streams/client/single-root-doc.ts"
	},
	"dependencies": {},
	"author": {
		"name": "Kyle Mistele",
		"url": "https://x.com/0xblacklight"
	}
}
