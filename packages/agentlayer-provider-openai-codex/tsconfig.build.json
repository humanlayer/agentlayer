{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src"],
	"exclude": [
		"test",
		"dist",
		"node_modules",
		"src/vendor",
		"src/vendor-protocol.ts",
		"**/*.test.*",
		"**/*.bench.*",
		"**/*.test-d.ts",
		"**/__tests__/**",
		"**/__mocks__/**",
		"**/__snapshots__/**"
	]
}
