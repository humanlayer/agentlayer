{
	"name": "@humanlayer/yjs-fs-editor",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --parallel dev:caddy dev:server dev:vite",
		"dev:vite": "vite --port 5175",
		"dev:server": "bun run server/index.ts",
		"dev:caddy": "caddy run --config Caddyfile",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@durable-streams/server": "^0.1.7",
		"@durable-streams/y-durable-streams": "^0.2.4",
		"@pierre/trees": "^1.0.0-beta.3",
		"@tiptap/extension-collaboration": "^2.11.0",
		"@tiptap/extension-collaboration-cursor": "^2.11.0",
		"@tiptap/react": "^2.11.0",
		"@tiptap/starter-kit": "^2.11.0",
		"@tanstack/react-router": "^1.93.0",
		"@humanlayer/yjs-fs-react": "workspace:*",
		"monaco-editor": "^0.52.0",
		"y-monaco": "^0.1.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"yjs": "13.6.30",
		"y-protocols": "1.0.7",
		"@humanlayer/yjs-fs": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@tanstack/router-plugin": "^1.93.0",
		"@vitejs/plugin-react": "^4.3.4",
		"typescript": "^5.6.3",
		"vite": "^6.0.0",
		"vite-plugin-monaco-editor": "^1.1.0"
	}
}
