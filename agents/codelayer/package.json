{
	"name": "@humanlayer/codelayer",
	"source": "./src/index.ts",
	"type": "module",
	"version": "0.0.36",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"codelayer": "./dist/cli.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"start": "bun run cli",
		"test": "bun test --conditions=source ./test/*.test.ts",
		"typecheck": "tsgo --noEmit",
		"build": "bun run build:js && bunx tsc -p tsconfig.build.json",
		"build:js": "bun run build.ts",
		"build:types": "bunx tsc -p tsconfig.build.json",
		"cli": "bun run src/cli.ts",
		"codelayer": "bun --bun run src/cli.ts"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"bun": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./rpi-agents": {
			"source": "./src/rpi-agents/index.ts",
			"bun": "./src/rpi-agents/index.ts",
			"types": "./dist/rpi-agents/index.d.ts",
			"import": "./dist/rpi-agents/index.js",
			"default": "./dist/rpi-agents/index.js"
		}
	},
	"dependencies": {
		"@ai-sdk/anthropic": "catalog:",
		"@ai-sdk/openai": "catalog:",
		"@aws/bedrock-token-generator": "catalog:",
		"@aws-sdk/credential-providers": "catalog:",
		"@humanlayer/agentlayer-core": "workspace:*",
		"@humanlayer/agentlayer-filesystem": "workspace:*",
		"@humanlayer/agentlayer-provider-auth": "workspace:*",
		"@humanlayer/agentlayer-provider-github-copilot": "workspace:*",
		"@humanlayer/agentlayer-provider-openai-codex": "workspace:*",
		"@smithy/types": "catalog:",
		"@smithy/config-resolver": "catalog:",
		"@smithy/node-config-provider": "catalog:",
		"ai": "catalog:",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ai-sdk/provider": "catalog:",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
