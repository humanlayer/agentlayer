{
	"name": "@humanlayer/yjs-rich-markdown-demo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --parallel dev:server dev:vite",
		"dev:vite": "vite --port 5176",
